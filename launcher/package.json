{
  "name": "glass-launcher",
  "productName": "Glass Launcher",
  "version": "0.1.0",
  "description": "A liquid-glass Minecraft Java launcher for macOS with built-in mod browsing and Grok-powered mod upgrades.",
  "author": "glchedmc",
  "license": "MIT",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV=1 electron .\"",
    "build:renderer": "vite build",
    "build:mod": "node scripts/build-companion.js",
    "icon": "node scripts/make-icon.mjs",
    "test": "node --test test/*.test.js",
    "screenshots": "node scripts/screenshots.mjs",
    "dist:mac": "npm run icon && npm run build:renderer && electron-builder --mac zip --arm64 --x64 --publish never"
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "playwright-core": "^1.56.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "mc.glched.glasslauncher",
    "productName": "Glass Launcher",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "core/**",
      "renderer-dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": "resources/"
      }
    ],
    "mac": {
      "category": "public.app-category.games",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "target": [
        "zip"
      ],
      "extendInfo": {
        "NSRequiresAquaSystemAppearance": false
      }
    }
  }
}
