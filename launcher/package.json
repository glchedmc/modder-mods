{
  "name": "saturn-client",
  "productName": "Saturn Client",
  "version": "0.1.12",
  "description": "Saturn Client: a liquid-glass Minecraft Java launcher for macOS and Linux with built-in mod browsing, friends and encrypted chat, one-click peer-to-peer world joins with voice chat, skins and a skin editor, cosmetics and Grok-powered mod upgrades.",
  "author": {
    "name": "glchedmc",
    "email": "glchedmc@users.noreply.github.com"
  },
  "license": "MIT",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV=1 electron .\"",
    "build:renderer": "vite build",
    "build:mod": "node scripts/build-companion.js",
    "icon": "node scripts/make-icon.mjs",
    "inject": "node scripts/inject-defaults.js",
    "test": "node --test test/*.test.js",
    "screenshots": "node scripts/screenshots.mjs",
    "dist:mac": "npm run inject && npm run icon && npm run build:renderer && electron-builder --mac zip --arm64 --x64 --publish never",
    "dist:mac:arm64": "npm run inject && npm run icon && npm run build:renderer && electron-builder --mac dir --arm64 --publish never",
    "dist:linux": "npm run inject && npm run icon && npm run build:renderer && electron-builder --linux AppImage deb tar.gz --x64 --publish never",
    "smoke:p2p": "electron scripts/p2p-smoke.js",
    "smoke:friends": "electron scripts/friends-smoke.js"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "nostr-tools": "^2.26.0",
    "qrcode": "^1.5.4",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "playwright-core": "^1.56.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "skinview3d": "^3.4.2",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "com.glchedmc.saturnclient",
    "productName": "Saturn Client",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "core/**",
      "renderer-dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": "resources/"
      },
      {
        "from": "core/builtin-private.js",
        "to": "builtin-private.js"
      }
    ],
    "mac": {
      "category": "public.app-category.games",
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "target": [
        "zip"
      ],
      "extendInfo": {
        "NSRequiresAquaSystemAppearance": false,
        "NSMicrophoneUsageDescription": "Saturn Client needs the microphone so voice chat mods like Simple Voice Chat can hear you in game.",
        "CFBundleDisplayName": "Saturn Client"
      },
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "saturn-client",
      "artifactName": "SaturnClient-${version}-${arch}.${ext}",
      "icon": "build/icon.png",
      "category": "Game",
      "synopsis": "Liquid-glass Minecraft launcher",
      "maintainer": "glchedmc <glchedmc@users.noreply.github.com>",
      "desktop": {
        "entry": {
          "Name": "Saturn Client",
          "StartupWMClass": "saturn-client",
          "Keywords": "minecraft;launcher;mods;"
        }
      },
      "syncDesktopName": true
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ],
      "recommends": [
        "gnome-keyring"
      ]
    }
  },
  "homepage": "https://github.com/glchedmc/modder-mods",
  "desktopName": "saturn-client.desktop"
}
